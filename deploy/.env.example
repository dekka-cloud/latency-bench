# Where this target runs and who hosts it. Results show these, so be specific.
BENCH_LOCATION=Frankfurt, Germany
BENCH_PROVIDER=Example Cloud

# A domain pointing at this machine, for real HTTPS through the tls profile.
DOMAIN=

# With the tls profile Caddy takes ports 80 and 443, so move the target's own ports.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Set to /data to keep results people share from the browser page.
BENCH_COLLECT=
